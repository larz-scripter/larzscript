# ping - shell command: real ICMP ping over LarzOS's own network stack
# (kernel/net.c, via the `net` package).
#
#   ping HOST_OR_IP

import "net" as net
import "ip" as ip

fn run(args) {
  if len(args) == 0 { print("usage: ping HOST_OR_IP"); return }
  if not net.status()["up"] { print("ping: no network link"); return }
  let target = args[0]
  let addr = ip.is_valid(target) ? target : net.resolve(target)
  if addr == nil { print("ping: could not resolve " + target); return }
  print("PING " + target + " (" + addr + ")")
  if net.ping(addr) { print("reply from " + addr) } else { print("timeout: no reply from " + addr) }
}
