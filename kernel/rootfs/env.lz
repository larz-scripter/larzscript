# env - parse/load .env files into a dict, with typed get() so you
# don't have to str()->int() every numeric setting by hand. Handles
# comments, a leading "export ", and quoted values. Keep real secrets
# out of Git - load them from a .env file this way instead.
#
#   import "env" as env_
#   let e = env_.load(".env")
#   print(env_.get_int(e, "PORT", 8080))
#   print(env_.get_bool(e, "DEBUG", false))

fn parse(text) {
  let out = {}
  for raw_line in text.split("\n") {
    let line = raw_line.strip()
    if len(line) == 0 or line[0:1] == "#" { continue }
    if line[0:7] == "export " { line = line[7:].strip() }
    let eq = line.find("=")
    if eq < 0 { continue }
    let key = line[0:eq].strip()
    let val = line[eq + 1:].strip()
    let hash_pos = val.find(" #")
    if hash_pos >= 0 and not (len(val) >= 2 and (val[0:1] == "\"" or val[0:1] == "'")) {
      val = val[0:hash_pos].strip()
    }
    if len(val) >= 2 and (val[0:1] == "\"" or val[0:1] == "'") and val[len(val)-1:] == val[0:1] {
      val = val[1:len(val)-1]
    }
    out[key] = val
  }
  return out
}

fn load(path) { return parse(read_file(path)) }

fn get(e, key, default_=nil) { return e.has(key) ? e[key] : default_ }

fn get_int(e, key, default_=nil) { return e.has(key) ? int(e[key]) : default_ }

fn get_float(e, key, default_=nil) { return e.has(key) ? float(e[key]) : default_ }

let _TRUE_WORDS = ["1", "true", "yes", "on"]
fn get_bool(e, key, default_=nil) {
  if not e.has(key) { return default_ }
  return e[key].lower() in _TRUE_WORDS
}
