# pay - send money to another user.  usage: pay <user> <amount>   (e.g. pay bob 5 or 5.50)
import "bank" as bank
fn _cents(s) {
  if s.starts_with("$") { s = s[1:] }
  if s.contains(".") { let p = s.split("."); return int(p[0]) * 100 + int((p[1] + "00")[0:2]) }
  return int(s) * 100
}
fn run(args) {
  if len(args) < 2 { print("usage: pay <user> <amount>   (e.g. pay bob 5  or  pay bob 5.50)"); return }
  let cents = _cents(args[1])
  if bank.transfer(args[0], cents) { print("paid " + bank.fmt(cents) + " to " + args[0] + " (your balance " + bank.fmt(bank.balance()) + ")") }
  else { print("payment failed: insufficient funds or bad recipient") }
}
