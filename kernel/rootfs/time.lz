# time - time and duration helpers (built on the time()/clock()/date()/
# datetime() builtins). Never reads the clock itself for ago()/humanize()/
# parse_duration() - every function that needs "now" takes it as an
# argument, so tests pass fixed numbers instead of racing the real clock.
#
#   import "time" as time
#   let start = time.stopwatch(); ...; print(time.elapsed(start))
#   print(time.humanize(93784))     # "1d 2h 3m 4s"
#   print(time.today())             # "2026-08-01" (UTC)
#   print(time.now_iso())           # "2026-08-01T17:33:21Z" (UTC)
#   print(time.parse_duration("1h30m"))   # 5400
#   print(time.ago(time.now() - 3600, time.now()))   # "1 hour ago"

import "duration" as duration_pkg

fn now() { return time() }
fn stopwatch() { return clock() }
fn elapsed(start) { return clock() - start }
# Pure, portable epoch->calendar (UTC, no shell-out) - kernel-portable, unlike
# format() below. today()/now_iso() default to the current time.
fn today(ts=nil) { return ts == nil ? date() : date(ts) }
fn now_iso(ts=nil) { return ts == nil ? datetime() : datetime(ts) }

fn humanize(secs) {
  let s = int(secs)
  if s < 0 { return "-" + humanize(-s) }
  let parts = []
  let d = s // 86400
  if d > 0 { parts.push(str(d) + "d"); s = s % 86400 }
  let h = s // 3600
  if h > 0 { parts.push(str(h) + "h"); s = s % 3600 }
  let m = s // 60
  if m > 0 { parts.push(str(m) + "m"); s = s % 60 }
  if s > 0 or len(parts) == 0 { parts.push(str(s) + "s") }
  return join(parts, " ")
}

fn _q(s) { return "'" + str(s).replace("'", "'\\''") + "'" }
# Format a unix timestamp using the system `date` (strftime-style format,
# hosted-only - shells out, needs a real `date` binary; use today()/now_iso()
# above for a portable, kernel-safe fixed format instead).
fn format(ts, fmt) { return capture("date -d @" + str(int(ts)) + " +" + _q(fmt)).strip() }

fn parse_duration(s) { return duration_pkg.parse(s) }

# A short relative-time phrase: "just now", "5 minutes ago", "in 3 days".
fn ago(then, now_=nil) {
  let n = now_ == nil ? now() : now_
  let diff = n - then
  let future = diff < 0
  let s = int(future ? -diff : diff)
  let value = 0
  let unit = ""
  if s < 45 { return future ? "in a few seconds" : "just now" }
  else if s < 90 { value = 1; unit = "minute" }
  else if s < 2700 { value = int(s / 60 + 0.5); unit = "minute" }
  else if s < 5400 { value = 1; unit = "hour" }
  else if s < 79200 { value = int(s / 3600 + 0.5); unit = "hour" }
  else if s < 129600 { value = 1; unit = "day" }
  else if s < 2160000 { value = int(s / 86400 + 0.5); unit = "day" }
  else if s < 5184000 { value = 1; unit = "month" }
  else if s < 29808000 { value = int(s / 2592000 + 0.5); unit = "month" }
  else if s < 47304000 { value = 1; unit = "year" }
  else { value = int(s / 31536000 + 0.5); unit = "year" }
  let plural = value == 1 ? unit : unit + "s"
  return future ? "in " + str(value) + " " + plural : str(value) + " " + plural + " ago"
}
