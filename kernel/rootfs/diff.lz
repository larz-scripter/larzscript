# diff - line-based diff between two strings (LCS-based, like a
# simplified unified diff), pure Larzscript. Fine for typical file/config
# sizes - the LCS table is O(n*m) time and space, not tuned for huge
# inputs.
#
#   import "diff" as diff
#   print(diff.lines(old_text, new_text))
#   #   same line
#   # - removed line
#   # + added line

fn lines(a, b) {
  let la = a.split("\n")
  let lb = b.split("\n")
  let n = len(la)
  let m = len(lb)
  let lcs = [[0 for _ in range(m + 1)] for _ in range(n + 1)]
  let i = n - 1
  while i >= 0 {
    let j = m - 1
    while j >= 0 {
      if la[i] == lb[j] { lcs[i][j] = lcs[i + 1][j + 1] + 1 }
      else { lcs[i][j] = lcs[i + 1][j] > lcs[i][j + 1] ? lcs[i + 1][j] : lcs[i][j + 1] }
      j = j - 1
    }
    i = i - 1
  }
  let out = []
  i = 0
  let j = 0
  while i < n and j < m {
    if la[i] == lb[j] { out.push("  " + la[i]); i = i + 1; j = j + 1 }
    else if lcs[i + 1][j] >= lcs[i][j + 1] { out.push("- " + la[i]); i = i + 1 }
    else { out.push("+ " + lb[j]); j = j + 1 }
  }
  while i < n { out.push("- " + la[i]); i = i + 1 }
  while j < m { out.push("+ " + lb[j]); j = j + 1 }
  return join(out, "\n")
}
