# json - parse and stringify JSON, in pure Larzscript. Parse errors name
# the exact character position they failed at. get() walks a dotted path
# through nested dicts/lists (numeric segments index into a list);
# pretty() indents; summarize() describes the shape in plain English;
# validate() checks a dotted-path schema against parsed data.
#
#   import "json" as json
#   let data = json.parse("{\"a\": [1, 2, 3], \"ok\": true}")
#   print(data["a"][1])                 # 2
#   print(json.stringify(data))         # {"a":[1,2,3],"ok":true}
#   print(json.get(data, "a.0", nil))    # 1
#   print(json.pretty(data))
#   print(json.summarize(data))
#   print(json.validate(data, {"a": "list", "ok": "bool"}))

fn _err(st, msg) { throw {"type": "JsonError", "message": msg + " at position " + str(st["i"])} }

fn _peek(st) { if st["i"] >= len(st["s"]) { return "" } return st["s"][st["i"]] }
fn _next(st) { let c = _peek(st); st["i"] = st["i"] + 1; return c }

fn _skip_ws(st) {
  while st["i"] < len(st["s"]) {
    let c = st["s"][st["i"]]
    if c == " " or c == "\n" or c == "\t" or c == "\r" { st["i"] = st["i"] + 1 } else { break }
  }
}

fn _parse_string(st) {
  _next(st)                              # opening quote
  let out = ""
  while true {
    if st["i"] >= len(st["s"]) { _err(st, "unterminated string") }
    let c = _next(st)
    if c == "\"" { break }
    if c == "\\" {
      let e = _next(st)
      if e == "n" { out = out + "\n" }
      else if e == "t" { out = out + "\t" }
      else if e == "r" { out = out + "\r" }
      else if e == "\"" { out = out + "\"" }
      else if e == "\\" { out = out + "\\" }
      else if e == "/" { out = out + "/" }
      else { out = out + e }
    } else { out = out + c }
  }
  return out
}

fn _parse_number(st) {
  let start = st["i"]
  while st["i"] < len(st["s"]) {
    let c = st["s"][st["i"]]
    if (c >= "0" and c <= "9") or c == "-" or c == "+" or c == "." or c == "e" or c == "E" {
      st["i"] = st["i"] + 1
    } else { break }
  }
  return float(st["s"][start:st["i"]])
}

fn _parse_array(st) {
  _next(st)                              # [
  let out = []
  _skip_ws(st)
  if _peek(st) == "]" { _next(st); return out }
  while true {
    out.push(_parse_value(st))
    _skip_ws(st)
    let c = _next(st)
    if c == "]" { break }
    if c != "," { _err(st, "expected ',' or ']' in array") }
  }
  return out
}

fn _parse_object(st) {
  _next(st)                              # {
  let out = {}
  _skip_ws(st)
  if _peek(st) == "}" { _next(st); return out }
  while true {
    _skip_ws(st)
    if _peek(st) != "\"" { _err(st, "expected a string key") }
    let key = _parse_string(st)
    _skip_ws(st)
    if _next(st) != ":" { _err(st, "expected ':' after key") }
    out[key] = _parse_value(st)
    _skip_ws(st)
    let c = _next(st)
    if c == "}" { break }
    if c != "," { _err(st, "expected ',' or '}' in object") }
  }
  return out
}

fn _parse_value(st) {
  _skip_ws(st)
  let c = _peek(st)
  if c == "{" { return _parse_object(st) }
  if c == "[" { return _parse_array(st) }
  if c == "\"" { return _parse_string(st) }
  if c == "t" { st["i"] = st["i"] + 4; return true }
  if c == "f" { st["i"] = st["i"] + 5; return false }
  if c == "n" { st["i"] = st["i"] + 4; return nil }
  return _parse_number(st)
}

fn parse(text) {
  let st = {"s": text, "i": 0}
  let v = _parse_value(st)
  _skip_ws(st)
  return v
}

fn _quote(s) {
  let out = "\""
  for c in str(s) {
    if c == "\"" { out = out + "\\\"" }
    else if c == "\\" { out = out + "\\\\" }
    else if c == "\n" { out = out + "\\n" }
    else if c == "\t" { out = out + "\\t" }
    else if c == "\r" { out = out + "\\r" }
    else { out = out + c }
  }
  return out + "\""
}

fn stringify(v) {
  let t = type(v)
  if t == "nil" { return "null" }
  if t == "bool" { return v ? "true" : "false" }
  if t == "number" { return str(v) }
  if t == "string" { return _quote(v) }
  if t == "list" { return "[" + join([stringify(x) for x in v], ",") + "]" }
  if t == "dict" { return "{" + join([_quote(str(k)) + ":" + stringify(v[k]) for k in keys(v)], ",") + "}" }
  return _quote(str(v))
}

fn _is_index(s) {
  if len(s) == 0 { return false }
  for c in s { if "0123456789".find(c) < 0 { return false } }
  return true
}

# Dotted path through nested dicts/lists - a numeric segment ("0") means
# "index into a list", not "the string key '0'".
fn get(data, path, default_=nil) {
  let cur = data
  for part in path.split(".") {
    if type(cur) == "list" and _is_index(part) {
      let idx = int(part)
      if idx < 0 or idx >= len(cur) { return default_ }
      cur = cur[idx]
    } else if type(cur) == "dict" and cur.has(part) {
      cur = cur[part]
    } else {
      return default_
    }
  }
  return cur
}

fn _pretty(v, indent, depth) {
  let pad = " " * (indent * (depth + 1))
  let close_pad = " " * (indent * depth)
  let t = type(v)
  if t == "list" {
    if len(v) == 0 { return "[]" }
    let parts = []
    for x in v { parts.push(pad + _pretty(x, indent, depth + 1)) }
    return "[\n" + join(parts, ",\n") + "\n" + close_pad + "]"
  }
  if t == "dict" {
    let ks = keys(v)
    if len(ks) == 0 { return "{}" }
    let parts = []
    for k in ks { parts.push(pad + _quote(str(k)) + ": " + _pretty(v[k], indent, depth + 1)) }
    return "{\n" + join(parts, ",\n") + "\n" + close_pad + "}"
  }
  return stringify(v)
}
fn pretty(v, indent=2) { return _pretty(v, indent, 0) }

fn _describe(v) {
  let t = type(v)
  if t == "list" { return "array of " + str(len(v)) + (len(v) == 1 ? " item" : " items") }
  if t == "dict" { return "object with " + str(len(keys(v))) + (len(keys(v)) == 1 ? " key" : " keys") }
  if t == "string" { return "string" }
  if t == "number" { return "number" }
  if t == "bool" { return "boolean" }
  return "null"
}

# A one-line, plain-English description of the top level's shape - "an
# object with 3 keys: a (array of 3 items), b (string), ok (boolean)".
fn summarize(v) {
  let t = type(v)
  if t == "dict" {
    let parts = []
    for k in keys(v) { parts.push(k + " (" + _describe(v[k]) + ")") }
    return "object with " + str(len(keys(v))) + (len(keys(v)) == 1 ? " key: " : " keys: ") + join(parts, ", ")
  }
  if t == "list" {
    return "array of " + str(len(v)) + (len(v) == 1 ? " item" : " items")
  }
  return _describe(v)
}

# schema: {"dotted.path": "string"|"number"|"bool"|"list"|"dict"} - the
# names type() itself returns. Returns a list of error strings.
fn validate(data, schema) {
  let errors = []
  for path in keys(schema) {
    let want = schema[path]
    let v = get(data, path, nil)
    if v == nil { errors.push(path + " is missing"); continue }
    let got = type(v)
    if got != want { errors.push(path + " should be " + want + " but is " + got) }
  }
  return errors
}
