# log - simple leveled logging with timestamps, structured key=value
# context fields, and either text or JSON output. bind() returns a
# logger carrying fields that are merged into every message it logs
# (e.g. a request id) - the plain module-level debug/info/warn/error
# calls are just bind({})'s equivalent with no persistent fields.
#
#   import "log" as log
#   log.set_level("info")
#   log.info("started")
#   log.info("request done", {"status": 200, "ms": 42})
#   log.set_format("json")
#   let rlog = log.bind({"request_id": "abc123"})
#   log.rinfo(rlog, "handling request")   # includes request_id automatically

import "json" as json

let _level = 1
let _names = ["DEBUG", "INFO", "WARN", "ERROR"]
let _format = "text"

fn set_level(name) {
  let i = 0
  for nm in _names { if nm == name.upper() { _level = i } i = i + 1 }
}
fn set_format(fmt) { _format = fmt }

fn bind(fields) { return {"fields": fields} }

fn _render(lvl, msg, fields) {
  let ts = capture("date +%H:%M:%S").strip()
  if _format == "json" {
    let d = {"ts": ts, "level": _names[lvl], "msg": msg}
    for k in keys(fields) { d[k] = fields[k] }
    return json.stringify(d)
  }
  let parts = []
  for k in keys(fields) { parts.push(k + "=" + str(fields[k])) }
  let ctx = len(parts) == 0 ? "" : " " + join(parts, " ")
  return "[" + ts + "] " + _names[lvl].ljust(5) + " " + str(msg) + ctx
}

fn _log(logger, lvl, msg, extra) {
  if lvl < _level { return nil }
  let fields = {}
  if logger != nil { for k in keys(logger["fields"]) { fields[k] = logger["fields"][k] } }
  for k in keys(extra) { fields[k] = extra[k] }
  print(_render(lvl, msg, fields))
}

fn debug(msg, extra={}) { _log(nil, 0, msg, extra) }
fn info(msg, extra={}) { _log(nil, 1, msg, extra) }
fn warn(msg, extra={}) { _log(nil, 2, msg, extra) }
fn error(msg, extra={}) { _log(nil, 3, msg, extra) }

fn rdebug(logger, msg, extra={}) { _log(logger, 0, msg, extra) }
fn rinfo(logger, msg, extra={}) { _log(logger, 1, msg, extra) }
fn rwarn(logger, msg, extra={}) { _log(logger, 2, msg, extra) }
fn rerror(logger, msg, extra={}) { _log(logger, 3, msg, extra) }
