# clock.lz - a desktop-icon-launched app (stage 4): creates its own window
# via ui.window(), no bespoke C wrapper needed at all (unlike the earlier
# task_clock() wrapper this replaced). Proves the same generic launch
# mechanism apptest.lz proved in stage 3, now reachable by clicking the
# "Clock" icon on the desktop instead of only from a hardcoded boot target.
ui.window("Clock", 260, 140)
ui.label("clock_time", 4, 4, "uptime: 0s")
let n = 0
while true {
  n = n + 1
  ui.set_text("clock_time", "uptime: " + str(n) + "s")
  sleep(1)
}
