# barcode - EAN-13 (real check-digit math and the standard L/G/R module
# encodings - the checksum algorithm and the encoding tables here are
# the same ones that appear across every EAN-13 reference source, and
# ean13_check_digit("400638133393") == 1 is a widely-cited worked
# example, both checked in this package's tests) and Code 128 Set B
# (the checksum math is spec-standard and independently verified here;
# the 107-symbol bar-pattern table is transcribed from memory rather
# than cross-checked against a second source, so treat Code 128 output
# as structurally correct - right symbol count, correct checksum, valid
# start/stop codes - rather than guaranteed scanner-verified the way
# EAN-13 is). Both render as SVG bars, no image library needed.
#
#   import "barcode" as barcode
#   print(barcode.ean13_check_digit("400638133393"))   # 1
#   print(barcode.ean13_svg("4006381333931"))
#   print(barcode.code128b_svg("HELLO-123"))

# ---- EAN-13 ----
# L-code (odd parity, left digits after the first), G-code (even parity,
# left digits when the first digit's parity pattern calls for it), and
# R-code (right-side digits) - the three standard 7-module patterns,
# 0=white 1=black, one row per digit 0-9.
let _EAN_L = ["0001101","0011001","0010011","0111101","0100011","0110001","0101111","0111011","0110111","0001011"]
let _EAN_G = ["0100111","0110011","0011011","0100001","0011101","0111001","0000101","0010001","0001001","0010111"]
let _EAN_R = ["1110010","1100110","1101100","1000010","1011100","1001110","1010000","1000100","1001000","1110100"]
# Which of L/G to use for each of the 6 left-hand digits, indexed by the
# first (13th) digit 0-9.
let _EAN_PARITY = ["LLLLLL","LLGLGG","LLGGLG","LLGGGL","LGLLGG","LGGLLG","LGGGLL","LGLGLG","LGLGGL","LGGLGL"]

fn ean13_check_digit(digits12) {
  if len(digits12) != 12 { throw {"type": "LarzValueError", "message": "ean13 check digit needs exactly 12 digits"} }
  let sum_ = 0
  let i = 0
  while i < 12 {
    let d = ord(digits12[i:i+1]) - 48
    sum_ = sum_ + d * (i % 2 == 0 ? 1 : 3)
    i = i + 1
  }
  return (10 - (sum_ % 10)) % 10
}

fn ean13_validate(digits13) {
  if len(digits13) != 13 { return false }
  for c in digits13 { if "0123456789".find(c) < 0 { return false } }
  return ean13_check_digit(digits13[0:12]) == (ord(digits13[12:13]) - 48)
}

# Returns the 95-module black/white bit string (guard-left-guard-right-
# guard), the standard EAN-13 layout.
fn ean13_pattern(digits13) {
  if not ean13_validate(digits13) { throw {"type": "LarzValueError", "message": "'" + digits13 + "' is not a valid EAN-13 (bad length or check digit)"} }
  let first = ord(digits13[0:1]) - 48
  let parity = _EAN_PARITY[first]
  let pattern = "101"
  let i = 1
  while i <= 6 {
    let d = ord(digits13[i:i+1]) - 48
    pattern = pattern + (parity[i-1:i] == "L" ? _EAN_L[d] : _EAN_G[d])
    i = i + 1
  }
  pattern = pattern + "01010"
  i = 7
  while i <= 12 {
    let d = ord(digits13[i:i+1]) - 48
    pattern = pattern + _EAN_R[d]
    i = i + 1
  }
  pattern = pattern + "101"
  return pattern
}

fn _bars_svg(pattern, module_width, height, quiet=10) {
  let bars = []
  let x = quiet
  for bit in pattern {
    if bit == "1" { bars.push("<rect x='" + str(x) + "' y='0' width='" + str(module_width) + "' height='" + str(height) + "' fill='black'/>") }
    x = x + module_width
  }
  let total_w = x + quiet
  return "<svg xmlns='http://www.w3.org/2000/svg' width='" + str(total_w) + "' height='" + str(height) +
    "'><rect width='100%' height='100%' fill='white'/>" + join(bars, "") + "</svg>"
}

fn ean13_svg(digits13, module_width=2, height=60) {
  return _bars_svg(ean13_pattern(digits13), module_width, height)
}

# ---- Code 128 Set B ----
# Symbol values 0-102 map to a printable ASCII char (space..DEL minus
# DEL, i.e. 0x20-0x7E) at value = ord(char) - 32; 103/104/105 are the
# START codes (only START B, 104, is used here); 106 is STOP.
let _CODE128_PATTERNS = [
  "11011001100","11001101100","11001100110","10010011000","10010001100","10001001100","10011001000","10011000100","10001100100","11001001000",
  "11001000100","11000100100","10110011100","10011011100","10011001110","10111001100","10011101100","10011100110","11001110010","11001011100",
  "11001001110","11011100100","11001110100","11101101110","11101001100","11100101100","11100100110","11101100100","11100110100","11100110010",
  "11011011000","11011000110","11000110110","10100011000","10001011000","10001000110","10110001000","10001101000","10001100010","11010001000",
  "11000101000","11000100010","10110111000","10110001110","10001101110","10111011000","10111000110","10001110110","11101110110","11010001110",
  "11000101110","11011101000","11011100010","11011101110","11101011000","11101000110","11100010110","11101101000","11101100010","11100011010",
  "11101111010","11001000010","11110001010","10100110000","10100001100","10010110000","10010000110","10000101100","10000100110","10110010000",
  "10110000100","10011010000","10011000010","10000110100","10000110010","11000010010","11001010000","11110111010","11000010100","10001111010",
  "10100111100","10010111100","10010011110","10111100100","10011110100","10011110010","11110100100","11110010100","11110010010","11011011110",
  "11011110110","11110110110","10101111000","10100011110","10001011110","10111101000","10111100010","11110101000","11110100010","10111011110",
  "10111101110","11101011110","11110101110","11010000100","11010010000","11010011100","1100011101011"
]
let _CODE128_START_B = 104
let _CODE128_STOP = 106

fn code128b_values(text) {
  let values = [_CODE128_START_B]
  for c in text {
    let v = ord(c) - 32
    if v < 0 or v > 94 { throw {"type": "LarzValueError", "message": "'" + c + "' is not in Code 128 Set B (printable ASCII 0x20-0x7E)"} }
    values.push(v)
  }
  let checksum = values[0]
  let i = 1
  while i < len(values) { checksum = checksum + values[i] * i; i = i + 1 }
  values.push(checksum % 103)
  values.push(_CODE128_STOP)
  return values
}

fn code128b_pattern(text) {
  let parts = []
  for v in code128b_values(text) { parts.push(_CODE128_PATTERNS[v]) }
  return join(parts, "")
}

fn code128b_svg(text, module_width=2, height=60) {
  return _bars_svg(code128b_pattern(text), module_width, height)
}
