# larzsh - the LarzOS shell, written entirely in Larzscript.
#
# An interactive command shell: it reads a line, parses it into a command and
# arguments, and runs it - either a shell builtin (cd/ls/cat/...) or an external
# program. LarzOS is money-native at its core, so the shell carries a built-in
# compute wallet: work is metered and a command that would overspend fails
# closed, exactly like `require` in the language.
#
#   larzscript os/larzsh.lz            # start an interactive session
#   echo "pwd\nls\nexit" | larzscript os/larzsh.lz   # scripted

let VERSION = "0.1"

# Desktop: create our own window and fill it with a terminal pane, the same
# generic ui.window()/ui.terminal() pattern every other desktop app uses -
# no bespoke C wrapper needed (kernel.c used to create this window/widget
# by hand via task_terminal(), now retired). A no-op on non-desktop boot
# targets since ui.window()/ui.terminal() lazily init the framebuffer only
# when actually called on a build that has one.
let MY_WINDOW = ui.window("Terminal", 640, 420)
let _sz = ui.window_size()
ui.terminal("term1", 0, 0, _sz[0], _sz[1])

import "bank" as bank
import "auth" as auth
import "color" as color
let LARZHOME = env("HOME") + "/.larzos"
let WALLET_FILE = LARZHOME + "/wallet.cents"
let HISTORY = []

# ---- money: the OS meters compute in a built-in wallet (integer cents) ----

fn wallet_load() {
  if not file_exists(WALLET_FILE) { return 10000 }        # new users start with $100.00 of compute credit
  let raw = read_file(WALLET_FILE).strip()
  if raw == "" { return 10000 }
  return int(raw)
}
fn wallet_save(cents) {
  mkdir(LARZHOME)
  write_file(WALLET_FILE, str(cents))
}
fn fmt_money(cents) {
  let sign = ""
  if cents < 0 { sign = "-"; cents = 0 - cents }
  let d = cents // 100
  let c = cents - d * 100
  let cc = str(c)
  if len(cc) < 2 { cc = "0" + cc }
  return sign + "$" + str(d) + "." + cc
}

# ---- helpers ----

fn short_cwd() {
  let c = cwd()
  let home = "/home/" + auth.session()
  if c == home { return "~" }
  if c.starts_with(home + "/") { return "~" + c[len(home):] }
  return c
}

# Split a command line into tokens, honoring "double quotes".
fn tokenize(line) {
  let toks = []
  let cur = ""
  let inq = false
  let have = false
  for ch in line {
    if ch == "\"" { inq = not inq; have = true }
    else if ch == " " and not inq {
      if have { toks.push(cur); cur = ""; have = false }
    } else { cur = cur + ch; have = true }
  }
  if have { toks.push(cur) }
  return toks
}

# ---- builtins ----

fn cmd_help() {
  print("LarzOS shell (larzsh) " + VERSION + " - builtins:")
  print("  cd [dir]        change directory (cd with no arg -> home)")
  print("  pwd             print the working directory")
  print("  ls [dir]        list a directory")
  print("  cat FILE...     print file contents")
  print("  echo TEXT...    print text")
  print("  mkdir DIR...    create directories")
  print("  rm PATH...      remove files")
  print("  touch FILE...   create empty files")
  print("  write FILE TXT  write text to a file")
  print("  env [NAME]      show environment (or one variable)")
  print("  whoami          print the current user")
  print("  clear           clear the screen")
  print("  balance         show your compute wallet balance")
  print("  earn N          credit N cents of compute (demo)")
  print("  ledger          show the money ledger (earns, payments, purchases)")
  print("  pay U AMOUNT    send money to another user (per-user wallets)")
  print("  windows         list open desktop windows")
  print("  launch NAME     open an app (terminal|clock|about|files)")
  print("  close N|NAME    close a window by index or title")
  print("  script FILE     run a sequence of shell commands from a file")
  print("  calc OP N [N2]  sqrt|pow|gcd|factorial|hex|bin|abs")
  print("  json FILE       pretty-print a JSON file")
  print("  csv FILE        parse a CSV file and render it as a table")
  print("  b64 ENC|DEC TXT base64 encode/decode text")
  print("  talk [N]        generate N words of text with a Markov chain (no network)")
  print("  ping HOST|IP    real ICMP ping over this kernel's own network stack")
  print("  netstat         show real link/MAC/IP/gateway status")
  print("  resolve HOST    real DNS lookup over this kernel's own network stack")
  print("  fetch HOST PATH real HTTP GET over this kernel's own network stack")
  print("  pkg ...         package manager: pkg list / install / remove")
  print("  history         show command history")
  print("  <name> ARGS     run an installed package (e.g. banner, todo, figlet)")
  print("  libraries:      any script can now import \"json\"/\"csv\"/\"table\"/\"string\"/")
  print("                  \"mathx\"/\"random\"/\"color\"/\"html\"/\"args\"/\"test\"/\"cli\"/")
  print("                  \"log\"/\"time\"/\"base64\" - each file's header shows usage.")
  print("  money+ai+saas:  \"ratelimit\" (SaaS) - \"invoice\"/\"escrow\"/\"fx\"/\"loan\"/\"budget\"/")
  print("                  \"tax\" (money) - \"markov\"/\"sentiment\" (AI, no network) are")
  print("                  now importable too.")
  print("  security+net:   \"net\" (real networking, backs ping/netstat/resolve/fetch")
  print("                  above) - \"ip\"/\"acl\" (CIDR/allow-deny) - \"validate\" (input")
  print("                  hygiene) - \"password_strength\" are now importable too.")
  print("  dev tools:      \"uuid\"/\"yaml\"/\"diff\" are now importable too.")
  print("                  (\"ai\"/\"crypto\"/\"webhook\"/\"apikey\"/\"totp\"/\"jwt\" need curl or")
  print("                  heavy looping this kernel's 8MB heap can't sustain - use them")
  print("                  from native/hosted Larzscript instead.)")
  print("  text:           cat | edit | grep | head | wc | write | echo | man")
  print("  server:         top | service | target | logs | uname | free | df | ps | hostname")
  print("  users:          whoami | id | users | useradd | passwd | su | logout")
  print("  net/time:       date | uptime | reboot | shutdown")
  print("  about           about LarzOS")
  print("  help            this help")
  print("  exit            leave LarzOS")
  print("anything else is run as an external program.")
  return 0
}

fn cmd_about() {
  print("")
  print("  LarzOS " + VERSION + "  -  the money-native operating system")
  print("  Its shell, init and utilities are written in Larzscript.")
  print("  https://github.com/larz-scripter/larzscript")
  print("")
  return 0
}

fn cmd_cd(rest) {
  let dir = env("HOME")
  if len(rest) > 0 { dir = rest[0] }
  if not chdir(dir) { print("cd: no such directory: " + dir); return 1 }
  return 0
}

fn cmd_ls(rest) {
  let dir = "."
  if len(rest) > 0 { dir = rest[0] }
  let names = listdir(dir)
  if len(names) == 0 { return 0 }
  for name in sorted(names) { print(name) }
  return 0
}

fn cmd_cat(rest) {
  let rc = 0
  for path in rest {
    if not file_exists(path) { print("cat: no such file: " + path); rc = 1 }
    else { print(read_file(path)) }
  }
  return rc
}

fn cmd_env(rest) {
  if len(rest) > 0 { print(env(rest[0])); return 0 }
  for k in ["HOME", "USER", "SHELL", "PATH", "PWD"] {
    let v = env(k)
    if v != nil and v != "" { print(k + "=" + v) }
  }
  return 0
}

# ---- desktop control: drive the GUI from the terminal, not just the mouse ----

fn cmd_windows() {
  for w in ui.windows() {
    print(str(w["index"]) + (w["focused"] ? " * " : "   ") + w["title"])
  }
  return 0
}

let LAUNCHABLE = {"terminal": "/larzsh.lz", "clock": "/clock.lz", "about": "/about.lz", "files": "/files.lz"}
fn cmd_launch(rest) {
  if len(rest) == 0 { print("usage: launch <name>  (terminal|clock|about|files)"); return 1 }
  let name = rest[0].lower()
  if not LAUNCHABLE.has(name) { print("launch: unknown app: " + name); return 1 }
  if not ui.launch(LAUNCHABLE[name]) { print("launch: no free app slot - close a window first"); return 1 }
  return 0
}

fn cmd_close(rest) {
  if len(rest) == 0 { print("usage: close <index|name>"); return 1 }
  let target = rest[0]
  for w in ui.windows() {
    if str(w["index"]) == target or w["title"].lower().contains(target.lower()) {
      let is_self = (w["index"] == MY_WINDOW)
      if is_self { print("goodbye.") }        # print BEFORE closing - ui.close() below tears
      ui.close(w["index"])                    # down this task's own terminal widget, same real
      if is_self {                            # path (task_exit+gfx_window_close) any other
        while true { sleep(1) }               # window's close-X already uses. Can't return to
      }                                       # the normal read-eval loop afterward - there's no
      return 0                                # window/input left to read from - just idle like
    }                                         # any other app (task_exit() already parked this
  }                                            # task; the next scheduler tick stops resuming it).
  print("close: no such window: " + target)
  return 1
}

# `script FILE` - runs a sequence of shell commands from a file, echoing
# each one before running it (like a real shell's `-x` trace), reusing
# run_command()/tokenize() exactly as-is - a "script" here is a flat list
# of commands, not a control-flow language: no if/while/variables inside
# the file itself. Real control-flow already exists with zero new code via
# the pkg-fallback below (any .lz file defining fn run(args) gets full
# Larzscript - loops, conditionals, all of it - the moment its name is
# typed); this is deliberately not a second, heavier eval mechanism.
fn cmd_script(rest) {
  if len(rest) == 0 { print("usage: script FILE"); return 1 }
  if not file_exists(rest[0]) { print("script: no such file: " + rest[0]); return 1 }
  let state = {}
  for line in read_file(rest[0]).split("\n") {
    let trimmed = line.strip()
    if trimmed == "" or trimmed.starts_with("#") { continue }
    print("+ " + trimmed)
    state = run_command(tokenize(trimmed), state)
  }
  return 0
}

# ---- the dispatcher ----

fn run_command(argv, state) {
  if len(argv) == 0 { return state }
  let cmd = argv[0]
  let rest = argv[1:]

  if cmd == "exit" or cmd == "quit" or cmd == "logout" {
    print("goodbye.")
    exit(0)
  }
  if cmd == "help" { cmd_help(); return state }
  if cmd == "about" or cmd == "ver" or cmd == "version" { cmd_about(); return state }
  if cmd == "cd" { cmd_cd(rest); return state }
  if cmd == "pwd" { print(cwd()); return state }
  if cmd == "ls" or cmd == "dir" { cmd_ls(rest); return state }
  if cmd == "echo" { print(join(rest, " ")); return state }
  if cmd == "cat" { cmd_cat(rest); return state }
  if cmd == "env" { cmd_env(rest); return state }
  if cmd == "clear" or cmd == "cls" { print(chr(27) + "[2J" + chr(27) + "[H"); return state }
  if cmd == "history" {
    let i = 1
    for h in HISTORY { print(str(i) + "  " + h); i = i + 1 }
    return state
  }
  if cmd == "mkdir" { for p in rest { mkdir(p) } return state }
  if cmd == "rm" or cmd == "del" { for p in rest { remove(p) } return state }
  if cmd == "touch" { for p in rest { write_file(p, "") } return state }
  if cmd == "write" {
    if len(rest) >= 2 { write_file(rest[0], join(rest[1:], " ")) }
    else { print("usage: write FILE TEXT") }
    return state
  }
  if cmd == "balance" or cmd == "wallet" {
    print("compute wallet: " + bank.fmt(bank.balance()))
    return state
  }
  if cmd == "earn" or cmd == "credit" {
    let add = 100
    if len(rest) > 0 { add = int(rest[0]) }
    bank.credit(add, "earn")
    print("credited " + bank.fmt(add) + "; balance " + bank.fmt(bank.balance()))
    return state
  }
  if cmd == "ledger" {
    let l = bank.ledger().strip()
    print(l == "" ? "(ledger empty)" : l)
    return state
  }
  if cmd == "windows" { cmd_windows(); return state }
  if cmd == "launch" { cmd_launch(rest); return state }
  if cmd == "close" { cmd_close(rest); return state }
  if cmd == "script" { cmd_script(rest); return state }
  # Any other word is a command: a Larzscript package (built in, or installed via
  # `pkg`) that defines `fn run(args)`, imported and executed in-process. Metered
  # - each run costs 1 cent of compute and fails closed (the money-native OS).
  if bank.balance() < 1 {
    print("larzsh: out of compute credit - run 'earn 100' to top up")
    return state
  }
  write_file("/dev/gas", "300")           # budget: 300 interpreter ticks; the kernel kills runaways
  try {
    import cmd as _mod
    _mod.run(rest)
  } catch e {
    if e["type"] == "ImportError" { print("larzsh: " + cmd + ": command not found  (try 'pkg list')") }
    else if e["type"] == "GasError" { print("larzsh: " + cmd + ": KILLED by the gas limiter (ran too long)") }
    else { print("larzsh: " + cmd + ": " + str(e["message"])) }
  }
  let gline = read_file("/proc/gas").split("\n")[0]     # "gas_used: N ticks"
  write_file("/dev/gas", "0")
  let gp = gline.split(" ")
  let ticks = len(gp) > 1 ? int(gp[1]) : 0
  bank.spend(1 + ticks // 10)              # bill: 1c + 1c per 10 ticks of CPU used
  return state
}

# ---- the read-eval loop ----

fn resolve_bin() {
  let bin = env("LARZOS_BIN")
  if bin == nil or bin == "" { bin = "os/bin" }
  if not bin.starts_with("/") { bin = cwd() + "/" + bin }   # make absolute so `cd` can't break it
  return bin
}

fn hostname() {
  let f = "/home/.larzos/hostname"
  return file_exists(f) ? read_file(f).strip() : "larzos"
}

fn main() {
  let home = "/home/" + auth.session()
  mkdir(home); chdir(home)          # start in the user's home directory
  let state = {}
  while true {
    let prompt_text = auth.session() + "@" + hostname() + ":" + short_cwd() + " (" + bank.fmt(bank.balance()) + ")$ "
    let line = input(color.green(prompt_text))
    if line == nil { print(""); break }          # EOF (Ctrl-D or end of piped input)
    let trimmed = line.strip()
    if trimmed == "" { continue }
    if not trimmed.starts_with("#") { HISTORY.push(trimmed) }
    let argv = tokenize(trimmed)
    state = run_command(argv, state)
  }
}

main()
