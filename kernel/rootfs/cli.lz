# cli - build command-line tools with subcommands and help. config_value()
# resolves a setting CLI flag > env var > default, the standard config
# precedence. from_function() is the "function -> CLI" bridge: Larzscript
# has no runtime introspection to derive a CLI from an arbitrary
# function's real parameter names, so you name them explicitly - the
# handler you write is then a plain function taking those values
# directly, not one that unpacks a flags/positional dict itself.
#
#   import "cli" as cli
#   let app = cli.new("todo", "a tiny todo tool")
#   cli.command(app, "add", "add an item", fn(a) { print("added " + a["positional"][0]) })
#   cli.from_function(app, "greet", "say hi", ["name"], fn(name) { print("hi " + name) })
#   cli.run(app, ["greet", "--name=Ada"])   # flags use --key=value, not a separate value token
#   cli.run(app, args)          # dispatches on the first argument
#   let port = cli.config_value(flags, "port", "APP_PORT", "8080")   # CLI > env > default

fn new(name, description) {
  return {"name": name, "desc": description, "commands": {}, "help": {}}
}

fn command(app, name, help, handler) {
  app["commands"][name] = handler
  app["help"][name] = help
}

fn _usage(app) {
  print(app["name"] + " - " + app["desc"])
  print("")
  print("commands:")
  let names = sorted(keys(app["commands"]))
  let width = 8
  for name in names { if len(name) + 2 > width { width = len(name) + 2 } }
  for name in names {
    print("  " + name.ljust(width) + app["help"][name])
  }
}

fn run(app, argv) {
  if len(argv) == 0 or argv[0] == "help" or argv[0] == "--help" {
    _usage(app)
    return
  }
  let cmd = argv[0]
  if not app["commands"].has(cmd) {
    print("unknown command: " + cmd)
    _usage(app)
    return
  }
  let flags = {}
  let positional = []
  for a in argv[1:] {
    if a.starts_with("--") {
      let body = a[2:]
      if body.contains("=") { let p = body.split("="); flags[p[0]] = join(p[1:], "=") }
      else { flags[body] = true }
    } else { positional.push(a) }
  }
  let handler = app["commands"][cmd]
  handler({"flags": flags, "positional": positional})
}

fn config_value(flags, key, env_name, default_) {
  if flags.has(key) { return flags[key] }
  let e = env(env_name, nil)
  if e != nil { return e }
  return default_
}

# Dispatches by NAME (--param value) if given, else by position, so
# `mytool greet Ada` and `mytool greet --name Ada` both work.
fn _apply_named(fn_, params, a) {
  let values = []
  let pos_i = 0
  for p in params {
    if a["flags"].has(p) { values.push(a["flags"][p]) }
    else if pos_i < len(a["positional"]) { values.push(a["positional"][pos_i]); pos_i = pos_i + 1 }
    else { values.push(nil) }
  }
  if len(values) == 1 { return fn_(values[0]) }
  if len(values) == 2 { return fn_(values[0], values[1]) }
  if len(values) == 3 { return fn_(values[0], values[1], values[2]) }
  if len(values) == 4 { return fn_(values[0], values[1], values[2], values[3]) }
  return fn_()
}

# `params`: the handler's parameter names, in order - named explicitly
# since Larzscript can't introspect a function's real signature.
fn from_function(app, name, help, params, fn_) {
  command(app, name, help, fn(a) { return _apply_named(fn_, params, a) })
}
