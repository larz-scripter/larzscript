# chart - inline SVG charts: line, area, bar, pie, and sparkline, in a
# light or dark theme. Every text value is XML-escaped, so a label with
# `<`/`&`/etc. in it can't break the SVG. No matplotlib, no canvas, no
# external renderer - just SVG markup, safe to inline directly into any
# HTML page.
#
#   import "chart" as chart
#   print(chart.bar([{"label": "Jan", "value": 10}, {"label": "Feb", "value": 25}]))
#   print(chart.line([1, 5, 3, 8, 2], {"theme": "dark"}))
#   print(chart.pie([{"label": "A", "value": 30}, {"label": "B", "value": 70}]))

fn _esc(s) {
  return str(s).replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace("\"", "&quot;")
}

let _LIGHT = {"bg": "#ffffff", "fg": "#1a1a1a", "grid": "#e0e0e0", "accent": "#3366cc"}
let _DARK = {"bg": "#1a1a1a", "fg": "#eeeeee", "grid": "#333333", "accent": "#66aaff"}
let _PALETTE = ["#3366cc", "#dc3912", "#ff9900", "#109618", "#990099", "#0099c6", "#dd4477"]

fn _theme(opts) { return opts.has("theme") and opts["theme"] == "dark" ? _DARK : _LIGHT }
fn _dims(opts) { return {"w": opts.has("width") ? opts["width"] : 400, "h": opts.has("height") ? opts["height"] : 200} }

fn _svg_open(w, h, bg) {
  return "<svg xmlns='http://www.w3.org/2000/svg' width='" + str(w) + "' height='" + str(h) +
    "' viewBox='0 0 " + str(w) + " " + str(h) + "'><rect width='100%' height='100%' fill='" + bg + "'/>"
}

fn _values_of(data) {
  let out = []
  for d in data { out.push(type(d) == "dict" ? d["value"] : d) }
  return out
}

fn line(data, opts={}) {
  let t = _theme(opts)
  let d = _dims(opts)
  let values = _values_of(data)
  let maxv = max(values)
  let minv = min(values)
  let range_ = maxv - minv
  if range_ == 0 { range_ = 1 }
  let n = len(values)
  let pad = 20
  let pts = []
  let i = 0
  while i < n {
    let x = pad + (d["w"] - 2 * pad) * (n == 1 ? 0 : i / (n - 1))
    let y = d["h"] - pad - (d["h"] - 2 * pad) * ((values[i] - minv) / range_)
    pts.push(str(x) + "," + str(y))
    i = i + 1
  }
  let svg = _svg_open(d["w"], d["h"], t["bg"])
  svg = svg + "<polyline points='" + join(pts, " ") + "' fill='none' stroke='" + t["accent"] + "' stroke-width='2'/>"
  svg = svg + "</svg>"
  return svg
}

fn area(data, opts={}) {
  let t = _theme(opts)
  let d = _dims(opts)
  let values = _values_of(data)
  let maxv = max(values)
  let minv = min(values)
  let range_ = maxv - minv
  if range_ == 0 { range_ = 1 }
  let n = len(values)
  let pad = 20
  let pts = []
  let i = 0
  while i < n {
    let x = pad + (d["w"] - 2 * pad) * (n == 1 ? 0 : i / (n - 1))
    let y = d["h"] - pad - (d["h"] - 2 * pad) * ((values[i] - minv) / range_)
    pts.push(str(x) + "," + str(y))
    i = i + 1
  }
  let baseline_y = d["h"] - pad
  let poly = pts + [str(d["w"] - pad) + "," + str(baseline_y), str(pad) + "," + str(baseline_y)]
  let svg = _svg_open(d["w"], d["h"], t["bg"])
  svg = svg + "<polygon points='" + join(poly, " ") + "' fill='" + t["accent"] + "' fill-opacity='0.3' stroke='" + t["accent"] + "' stroke-width='2'/>"
  svg = svg + "</svg>"
  return svg
}

fn bar(data, opts={}) {
  let t = _theme(opts)
  let d = _dims(opts)
  let maxv = max(_values_of(data))
  if maxv <= 0 { maxv = 1 }
  let n = len(data)
  let pad = 20
  let slot = (d["w"] - 2 * pad) / n
  let bar_w = slot * 0.7
  let svg = _svg_open(d["w"], d["h"], t["bg"])
  let i = 0
  while i < n {
    let item = data[i]
    let value = type(item) == "dict" ? item["value"] : item
    let label = type(item) == "dict" and item.has("label") ? item["label"] : str(i)
    let bh = (d["h"] - 2 * pad) * (value / maxv)
    let x = pad + slot * i + (slot - bar_w) / 2
    let y = d["h"] - pad - bh
    svg = svg + "<rect x='" + str(x) + "' y='" + str(y) + "' width='" + str(bar_w) + "' height='" + str(bh) + "' fill='" + t["accent"] + "'/>"
    svg = svg + "<text x='" + str(x + bar_w / 2) + "' y='" + str(d["h"] - 4) + "' font-size='10' text-anchor='middle' fill='" + t["fg"] + "'>" + _esc(label) + "</text>"
    i = i + 1
  }
  svg = svg + "</svg>"
  return svg
}

fn _pie_point(cx, cy, r, angle_deg) {
  let rad = angle_deg * 3.141592653589793 / 180
  # Manual sin/cos via Taylor series (see other packages) - no trig builtin.
  fn cosr(x) {
    let term = 1.0
    let total = 1.0
    let n = 1
    while n <= 10 { term = term * (-1) * x * x / ((2 * n - 1) * (2 * n)); total = total + term; n = n + 1 }
    return total
  }
  fn sinr(x) { return cosr(x - 3.141592653589793 / 2) }
  return {"x": cx + r * cosr(rad), "y": cy + r * sinr(rad)}
}

fn pie(data, opts={}) {
  let t = _theme(opts)
  let d = _dims(opts)
  let values = _values_of(data)
  let total = sum(values)
  if total <= 0 { total = 1 }
  let cx = d["w"] / 2
  let cy = d["h"] / 2
  let r = (d["h"] < d["w"] ? d["h"] : d["w"]) / 2 - 20
  let svg = _svg_open(d["w"], d["h"], t["bg"])
  let start_angle = -90.0
  let i = 0
  while i < len(data) {
    let item = data[i]
    let value = type(item) == "dict" ? item["value"] : item
    let sweep = 360.0 * (value / total)
    let end_angle = start_angle + sweep
    let p1 = _pie_point(cx, cy, r, start_angle)
    let p2 = _pie_point(cx, cy, r, end_angle)
    let large_arc = sweep > 180 ? 1 : 0
    let color = _PALETTE[i % len(_PALETTE)]
    svg = svg + "<path d='M " + str(cx) + " " + str(cy) + " L " + str(p1["x"]) + " " + str(p1["y"]) +
      " A " + str(r) + " " + str(r) + " 0 " + str(large_arc) + " 1 " + str(p2["x"]) + " " + str(p2["y"]) + " Z' fill='" + color + "'/>"
    start_angle = end_angle
    i = i + 1
  }
  svg = svg + "</svg>"
  return svg
}

let _SPARK_CHARS = " .:-=+*#%@"
fn sparkline(values) {
  let maxv = max(values)
  let minv = min(values)
  let range_ = maxv - minv
  if range_ == 0 { range_ = 1 }
  let out = ""
  for v in values {
    let idx = int(((v - minv) / range_) * (len(_SPARK_CHARS) - 1))
    out = out + _SPARK_CHARS[idx:idx+1]
  }
  return out
}
