# ratelimit - token-bucket rate limiting for Larzscript, in ~20 lines.
# Caller owns the state (a plain dict passed in every call) - no hidden
# global, no file I/O, works the same on the kernel as anywhere else.
# The clock is injectable: pass an explicit `now` to test refill timing
# deterministically instead of depending on real wall-clock time.
#
#   import "ratelimit" as ratelimit
#   let buckets = {}
#   if ratelimit.allow(buckets, "user:42", 10, 1.0) { ... }   # 10 tokens, refill 1/sec
#   else { print("rate limited") }
#   ratelimit.allow(buckets, "user:42", 10, 1.0, 100.0)   # test: as if clock() == 100.0

fn allow(buckets, key, capacity, refill_per_sec, now=nil) {
  let now_ = now == nil ? clock() : now
  if not buckets.has(key) {
    buckets[key] = {"tokens": capacity - 1, "last": now_}
    return true
  }
  let b = buckets[key]
  let elapsed = now_ - b["last"]
  let tokens = b["tokens"] + elapsed * refill_per_sec
  if tokens > capacity { tokens = capacity }
  b["last"] = now_
  if tokens < 1 { b["tokens"] = tokens; return false }
  b["tokens"] = tokens - 1
  return true
}

fn reset(buckets, key) { if buckets.has(key) { buckets.remove(key) } }
