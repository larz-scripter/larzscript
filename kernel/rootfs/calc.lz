# calc - a one-word command wrapper over Larzscript's own math builtins
# (sqrt/pow/gcd/factorial/hex/bin/abs), reachable from the shell the same
# way every other pkg-style command is - no new dispatcher code needed,
# larzsh.lz's existing fallback (`import cmd as _mod; _mod.run(rest)`)
# picks this up automatically by name.
fn run(args) {
  if len(args) < 2 { print("usage: calc <sqrt|pow|gcd|factorial|hex|bin|abs> N [N2]"); return }
  let op = args[0]
  if op == "sqrt" { print(str(sqrt(float(args[1])))) }
  else if op == "pow" { print(str(pow(float(args[1]), float(args[2])))) }
  else if op == "gcd" { print(str(gcd(int(args[1]), int(args[2])))) }
  else if op == "factorial" { print(str(factorial(int(args[1])))) }
  else if op == "hex" { print(hex(int(args[1]))) }
  else if op == "bin" { print(bin(int(args[1]))) }
  else if op == "abs" { print(str(abs(float(args[1])))) }
  else { print("calc: unknown op: " + op) }
}
