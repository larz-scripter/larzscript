# ascii - data as plain ASCII pictures: bar charts, histograms,
# sparklines, bordered tables, and progress bars. Works anywhere text
# does - no terminal capability detection, no color codes.
#
#   import "ascii" as ascii
#   print(ascii.bar_chart({"food": 45, "housing": 120}, 30))
#   print(ascii.sparkline([1, 5, 3, 8, 2, 9]))    # "▁▄▂▇▁█"-style, ascii-only here
#   print(ascii.progress_bar(7, 10, 20))           # "[##############------] 70%"
#   print(ascii.box("Hello"))

fn bar_chart(data, width) {
  let keys_ = keys(data)
  let max_v = 1
  for k in keys_ { if data[k] > max_v { max_v = data[k] } }
  let name_w = 0
  for k in keys_ { if len(str(k)) > name_w { name_w = len(str(k)) } }
  let lines = []
  for k in sorted(keys_) {
    let bar_len = int((data[k] / max_v) * width)
    if bar_len < 1 and data[k] > 0 { bar_len = 1 }
    lines.push(str(k).ljust(name_w) + " | " + ("#" * bar_len) + " " + str(data[k]))
  }
  return join(lines, "\n")
}

fn histogram(values, buckets) {
  let lo = min(values)
  let hi = max(values)
  let range_ = hi - lo
  if range_ == 0 { range_ = 1 }
  let counts = [0 for _ in range(buckets)]
  for v in values {
    let idx = int(((v - lo) / range_) * (buckets - 1))
    counts[idx] = counts[idx] + 1
  }
  let max_count = 1
  for c in counts { if c > max_count { max_count = c } }
  let lines = []
  let i = 0
  while i < buckets {
    let bucket_lo = lo + (range_ * i) / buckets
    let bar_len = int((counts[i] / max_count) * 30)
    lines.push(str(bucket_lo).ljust(8) + "| " + ("#" * bar_len) + " " + str(counts[i]))
    i = i + 1
  }
  return join(lines, "\n")
}

let SPARK_CHARS = " .:-=+*#%@"
fn sparkline(values) {
  let lo = min(values)
  let hi = max(values)
  let range_ = hi - lo
  if range_ == 0 { range_ = 1 }
  let out = ""
  for v in values {
    let idx = int(((v - lo) / range_) * (len(SPARK_CHARS) - 1))
    out = out + SPARK_CHARS[idx:idx+1]
  }
  return out
}

fn progress_bar(current, total, width) {
  if total <= 0 { total = 1 }
  let frac = current / total
  if frac > 1 { frac = 1 }
  if frac < 0 { frac = 0 }
  let filled = int(frac * width)
  let pct = int(frac * 100)
  return "[" + ("#" * filled) + ("-" * (width - filled)) + "] " + str(pct) + "%"
}

fn box(text) {
  let lines = text.split("\n")
  let w = 0
  for l in lines { if len(l) > w { w = len(l) } }
  let top = "+" + ("-" * (w + 2)) + "+"
  let body = [top]
  for l in lines { body.push("| " + l.ljust(w) + " |") }
  body.push(top)
  return join(body, "\n")
}
