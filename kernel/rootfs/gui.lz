# gui.lz - a real GUI on bare-metal LarzOS: VGA Mode 13h graphics, a
# keyboard-driven widget model (Tab focus, Enter click, no mouse in v1), and
# the SAME `ui` module vocabulary the browser build uses (ui.set_text,
# ui.on) - just backed by kernel/gfx.c instead of a DOM. Money-native, like
# the browser demo at larzos.com/larzscript/gui/: a wallet balance, a
# `pay`-driven buy button, and a `capability`-gated action using
# `pay ... requires NAME` + try/catch.
#
# The "term" pane below is an ordinary ui.terminal() - everything printed
# below with plain print() (exactly what a running server like
# ../rootfs/webserver.lz already does - "served 402 /article" and so on)
# shows up in it live, with no special GUI-aware code in those scripts at
# all. That's the whole point: this demo's own print() calls prove it.
wallet buyer = $10.00
wallet seller = $0.00
capability premium

fn render() {
  ui.set_text("bal", "buyer " + str(buyer.balance) + " - seller " + str(seller.balance))
}

fn buy_coffee() {
  if buyer.balance < $2.00 {
    print("buy_coffee: declined - insufficient funds")
    return
  }
  pay $2.00 from buyer to seller
  render()
  print("buy_coffee: charged $2.00, seller balance now " + str(seller.balance))
}

fn unlock() {
  grant premium
  print("unlock: premium capability granted")
}

fn use_premium() {
  try {
    pay $1.00 from buyer to seller requires premium
    render()
    print("use_premium: charged $1.00, seller balance now " + str(seller.balance))
  } catch e {
    print("use_premium: blocked - " + e["type"])
  }
}

fn do_quit() {
  print("shutting down")
  ui.quit()
}

ui.label("title", 10, 10, "LarzOS GUI - money-native")
ui.label("bal", 10, 30, "loading...")
ui.label("log", 10, 45, "tab = focus, enter = click")
ui.button("buy", 10, 70, 110, 24, "buy - $2.00")
ui.button("unlock", 130, 70, 130, 24, "unlock premium")
ui.button("premium", 10, 100, 180, 24, "use premium - $1.00")
ui.button("quit", 200, 100, 70, 24, "quit")
ui.terminal("term", 10, 130, 280, 60)

ui.on("buy", "click", buy_coffee)
ui.on("unlock", "click", unlock)
ui.on("premium", "click", use_premium)
ui.on("quit", "click", do_quit)

print("LarzOS GUI started")
render()
ui.run()

print("gui exited")
