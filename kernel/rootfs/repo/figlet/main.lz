# figlet - render UPPERCASE letters/digits as 5-row block art. usage: figlet TEXT
let F = {
  "A": ["  #  "," # # ","#####","#   #","#   #"], "B": ["#### ","#   #","#### ","#   #","#### "],
  "C": [" ####","#    ","#    ","#    "," ####"], "D": ["#### ","#   #","#   #","#   #","#### "],
  "E": ["#####","#    ","###  ","#    ","#####"], "F": ["#####","#    ","###  ","#    ","#    "],
  "G": [" ####","#    ","#  ##","#   #"," ####"], "H": ["#   #","#   #","#####","#   #","#   #"],
  "I": ["#####","  #  ","  #  ","  #  ","#####"], "L": ["#    ","#    ","#    ","#    ","#####"],
  "O": [" ### ","#   #","#   #","#   #"," ### "], "R": ["#### ","#   #","#### ","#  # ","#   #"],
  "S": [" ####","#    "," ### ","    #","#### "], "T": ["#####","  #  ","  #  ","  #  ","  #  "],
  "Z": ["#####","   # ","  #  "," #   ","#####"], " ": ["   ","   ","   ","   ","   "]
}
fn run(args) {
  let text = (len(args) > 0 ? join(args, " ") : "LARZOS").upper()
  for row in range(5) {
    let line = ""
    for ch in text { line = line + (F.has(ch) ? F[ch][row] : "?????") + " " }
    print(line)
  }
}
