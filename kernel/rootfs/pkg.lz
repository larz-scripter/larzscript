# pkg - the LarzOS package manager. Installs Larzscript packages from /repo into
# /home/.larzpkg (which persists across reboots), so they extend the OS. Once
# installed, run a package by name in larzsh, or `import "<name>"` from code.
let REPO = "/repo"
let LIB  = "/home/.larzpkg"
fn _meta(name) { let m = REPO + "/" + name + "/meta"; return file_exists(m) ? read_file(m).strip() : "" }
fn _available() { return file_exists(REPO) ? sorted(listdir(REPO)) : [] }
fn _installed() { return file_exists(LIB) ? sorted(listdir(LIB)) : [] }
fn cmd_list() {
  let avail = _available()
  if len(avail) == 0 { print("no packages in the repo"); return }
  let inst = _installed()
  print("available packages:")
  for name in avail {
    let mark = " "
    for i in inst { if i == name { mark = "*" } }
    print("  " + mark + " " + name.ljust(12) + _meta(name))
  }
  print("(* = installed)   install with:  pkg install <name>")
}
fn cmd_install(name) {
  let src = REPO + "/" + name
  if not file_exists(src) { print("no such package: " + name); return }
  mkdir(LIB); let dst = LIB + "/" + name; mkdir(dst)
  for f in listdir(src) { write_file(dst + "/" + f, read_file(src + "/" + f)) }
  print("installed " + name)
  if file_exists(dst + "/main.lz") { print("  try:  " + name + "     (or  import \"" + name + "\")") }
}
fn cmd_remove(name) {
  let dst = LIB + "/" + name
  if not file_exists(dst) { print("not installed: " + name); return }
  for f in listdir(dst) { remove(dst + "/" + f) }
  remove(dst); print("removed " + name)
}
fn cmd_info(name) {
  print(name + " - " + _meta(name))
  let src = REPO + "/" + name
  if file_exists(src) { print("  files: " + join(listdir(src), ", ")) }
}
fn run(args) {
  if len(args) == 0 or args[0] == "help" {
    print("pkg - LarzOS package manager")
    print("  pkg list               list available packages")
    print("  pkg install <name>     install a package (persists across reboots)")
    print("  pkg remove <name>      uninstall a package")
    print("  pkg installed          list installed packages")
    print("  pkg info <name>        show package details")
    return
  }
  let cmd = args[0]
  if cmd == "list" { cmd_list() }
  else if cmd == "install" and len(args) >= 2 { cmd_install(args[1]) }
  else if cmd == "remove" and len(args) >= 2 { cmd_remove(args[1]) }
  else if cmd == "installed" {
    let inst = _installed()
    if len(inst) == 0 { print("(nothing installed)") } else { for i in inst { print("  " + i) } }
  }
  else if cmd == "info" and len(args) >= 2 { cmd_info(args[1]) }
  else { print("unknown: pkg " + join(args, " ") + "   (try 'pkg help')") }
}
