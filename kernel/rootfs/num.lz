# num - human-friendly number formatting: thousands separators,
# ordinals, filesizes, k/M abbreviations, and percentages.
#
#   import "num" as num
#   print(num.commas(1234567))         # "1,234,567"
#   print(num.ordinal(23))              # "23rd"
#   print(num.filesize(1572864))        # "1.5 MB"
#   print(num.abbreviate(1234))         # "1.2k"
#   print(num.abbreviate(3450000))      # "3.5M" (round-half-up)
#   print(num.percent(0.4567, 1))       # "45.7%"

fn commas(n) {
  let neg = n < 0
  let v = neg ? -n : n
  let s = str(int(v))
  let out = ""
  let i = len(s)
  let count = 0
  while i > 0 {
    i = i - 1
    out = s[i:i+1] + out
    count = count + 1
    if count % 3 == 0 and i > 0 { out = "," + out }
  }
  return neg ? "-" + out : out
}

fn ordinal(n) {
  let v = n < 0 ? -n : n
  let last2 = v % 100
  let last1 = v % 10
  let suffix = "th"
  if last2 < 11 or last2 > 13 {
    if last1 == 1 { suffix = "st" }
    else if last1 == 2 { suffix = "nd" }
    else if last1 == 3 { suffix = "rd" }
  }
  return str(n) + suffix
}

let _FILE_UNITS = ["B", "KB", "MB", "GB", "TB", "PB"]
fn filesize(bytes_) {
  let v = bytes_
  let i = 0
  while v >= 1024 and i < len(_FILE_UNITS) - 1 {
    v = v / 1024
    i = i + 1
  }
  let rounded = int(v * 10 + 0.5) / 10
  return str(rounded) + " " + _FILE_UNITS[i]
}

let _ABBR = [{"v": 1000000000, "s": "B"}, {"v": 1000000, "s": "M"}, {"v": 1000, "s": "k"}]
fn abbreviate(n) {
  let neg = n < 0
  let v = neg ? -n : n
  for entry in _ABBR {
    if v >= entry["v"] {
      let scaled = int((v / entry["v"]) * 10 + 0.5) / 10
      return (neg ? "-" : "") + str(scaled) + entry["s"]
    }
  }
  return str(n)
}

fn percent(frac, decimals=0) {
  let scale = 10 ** decimals
  let v = int(frac * 100 * scale + 0.5) / scale
  return str(v) + "%"
}
