# password_strength - password strength scoring, pure Larzscript.
#
#   import "password_strength" as pwstrength
#   pwstrength.score("hunter2")        # 0..4
#   pwstrength.label("Tr0ub4dor&3")    # "strong"

let _COMMON = ["password", "123456", "12345678", "qwerty", "letmein",
               "admin", "welcome", "monkey", "dragon", "abc123", "iloveyou",
               "password1", "111111", "123123"]

fn score(pw) {
  if pw.lower() in _COMMON { return 0 }
  let s = 0
  if len(pw) >= 8 { s = s + 1 }
  if len(pw) >= 12 { s = s + 1 }
  let has_lower = false
  let has_upper = false
  let has_digit = false
  let has_symbol = false
  for c in pw {
    if c >= "a" and c <= "z" { has_lower = true }
    else if c >= "A" and c <= "Z" { has_upper = true }
    else if c >= "0" and c <= "9" { has_digit = true }
    else { has_symbol = true }
  }
  let classes = (has_lower ? 1 : 0) + (has_upper ? 1 : 0) + (has_digit ? 1 : 0) + (has_symbol ? 1 : 0)
  if classes >= 3 { s = s + 1 }
  if classes == 4 { s = s + 1 }
  return s
}

fn label(pw) {
  let sc = score(pw)
  if sc <= 1 { return "weak" }
  if sc <= 3 { return "fair" }
  return "strong"
}
