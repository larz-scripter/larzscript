# mathx - small pure-Larzscript math helpers (a Larzscript package)
let PI = 3.14159265358979

fn mean(xs) { return sum(xs) / len(xs) }

fn fib(n) {
  if n < 2 { return n }
  let a = 0
  let b = 1
  for i in range(n - 1) { let t = a + b; a = b; b = t }
  return b
}

fn is_prime(n) {
  if n < 2 { return false }
  for i in range(2, n) {
    if i * i > n { break }
    if n % i == 0 { return false }
  }
  return true
}

fn primes_up_to(limit) {
  return [n for n in range(2, limit + 1) if is_prime(n)]
}
