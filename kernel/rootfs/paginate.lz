# paginate - slice any list into pages, with the has_next/has_prev/
# 1-based-index bookkeeping every list-showing page in every app needs.
#
#   import "paginate" as paginate
#   let p = paginate.paginate(items, 2, 10)   # page 2, 10 per page
#   print(p["items"], p["pages"], p["has_next"], p["start"], p["end"])

fn paginate(items, page, per_page) {
  let total = len(items)
  let pages = total == 0 ? 1 : int((total - 1) / per_page) + 1
  let cur_page = page < 1 ? 1 : page
  if cur_page > pages { cur_page = pages }
  let start_idx = (cur_page - 1) * per_page
  let end_idx = start_idx + per_page
  if end_idx > total { end_idx = total }
  return {
    "items": items[start_idx:end_idx],
    "page": cur_page, "pages": pages, "per_page": per_page, "total": total,
    "has_next": cur_page < pages, "has_prev": cur_page > 1,
    "start": total == 0 ? 0 : start_idx + 1, "end": end_idx
  }
}
