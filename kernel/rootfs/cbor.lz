# cbor - RFC 8949 CBOR encode/decode, canonical (deterministic) form.
# Bytes are represented as a list of ints 0-255, NOT a Larzscript string -
# Larzscript strings are NUL-terminated C strings under the hood, so a
# 0x00 byte would silently truncate them. A byte-list is the honest,
# 8-bit-clean representation and round-trips exactly.
#
#   import "cbor" as cbor
#   let bytes_ = cbor.encode({"a": 1, "b": [1, 2, 3]})
#   print(cbor.decode(bytes_))

fn encode(v) {
  let out = []
  _enc(v, out)
  return out
}

fn _enc_head(major, n, out) {
  let mm = major * 32
  if n < 24 { out.push(mm + n) }
  else if n < 256 { out.push(mm + 24); out.push(n) }
  else if n < 65536 { out.push(mm + 25); out.push(n // 256); out.push(n % 256) }
  else {
    out.push(mm + 26)
    out.push((n // 16777216) % 256); out.push((n // 65536) % 256)
    out.push((n // 256) % 256); out.push(n % 256)
  }
}

fn _enc(v, out) {
  let t = type(v)
  if t == "nil" { out.push(246); return nil }
  if t == "bool" { out.push(v ? 245 : 244); return nil }
  if t == "number" {
    if v == int(v) {
      if v >= 0 { _enc_head(0, int(v), out) }
      else { _enc_head(1, int(-v) - 1, out) }
    } else {
      # float64, major type 7, additional info 27.
      out.push(251)
      for byte_ in _f64_bits(v) { out.push(byte_) }
    }
    return nil
  }
  if t == "string" {
    let byte_len = len(v)
    _enc_head(3, byte_len, out)
    for c in v { out.push(ord(c)) }
    return nil
  }
  if t == "list" {
    _enc_head(4, len(v), out)
    for item in v { _enc(item, out) }
    return nil
  }
  if t == "dict" {
    let ks = sorted(keys(v))
    _enc_head(5, len(ks), out)
    for k in ks { _enc(k, out); _enc(v[k], out) }
    return nil
  }
  throw {"type": "LarzValueError", "message": "cbor cannot encode a " + t}
}

# Portable float64 -> 8 big-endian bytes via manual IEEE-754 assembly (no
# bit-shift operators in Larzscript - see the `bits` package for why).
# Layout: byte[0] = sign(1) + exponent hi 7 bits; byte[1] = exponent lo 4
# bits + mantissa hi 4 bits; byte[2..7] = mantissa's low 48 bits,
# big-endian - the standard IEEE-754 binary64 bit layout.
fn _f64_bits(x) {
  let sign = x < 0 ? 1 : 0
  let v = x < 0 ? -x : x
  let bytes_ = [0, 0, 0, 0, 0, 0, 0, 0]
  if v == 0 { if sign == 1 { bytes_[0] = 128 } return bytes_ }
  let exp = 0
  while v >= 2 { v = v / 2; exp = exp + 1 }
  while v < 1 { v = v * 2; exp = exp - 1 }
  let biased = exp + 1023
  let frac = v - 1
  let mantissa = int(frac * 4503599627370496.0 + 0.5)  # 2^52
  if mantissa >= 4503599627370496 { mantissa = 0; biased = biased + 1 }
  let top4 = mantissa // 281474976710656              # 2^48 -> mantissa bits 51-48
  let low48 = mantissa % 281474976710656
  bytes_[0] = sign * 128 + biased // 16
  bytes_[1] = (biased % 16) * 16 + top4
  let m = low48
  let i = 7
  while i >= 2 {
    bytes_[i] = m % 256
    m = m // 256
    i = i - 1
  }
  return bytes_
}

fn _dec(bytes_, st) {
  let b0 = bytes_[st["i"]]
  st["i"] = st["i"] + 1
  let major = b0 // 32
  let info = b0 % 32
  let n = info
  if info == 24 { n = bytes_[st["i"]]; st["i"] = st["i"] + 1 }
  else if info == 25 { n = bytes_[st["i"]] * 256 + bytes_[st["i"]+1]; st["i"] = st["i"] + 2 }
  else if info == 26 {
    n = bytes_[st["i"]] * 16777216 + bytes_[st["i"]+1] * 65536 + bytes_[st["i"]+2] * 256 + bytes_[st["i"]+3]
    st["i"] = st["i"] + 4
  }
  if major == 0 { return n }
  if major == 1 { return -(n + 1) }
  if major == 3 {
    let s = ""
    let k = 0
    while k < n { s = s + chr(bytes_[st["i"]]); st["i"] = st["i"] + 1; k = k + 1 }
    return s
  }
  if major == 4 {
    let arr = []
    let k = 0
    while k < n { arr.push(_dec(bytes_, st)); k = k + 1 }
    return arr
  }
  if major == 5 {
    let d = {}
    let k = 0
    while k < n {
      let key = _dec(bytes_, st)
      d[key] = _dec(bytes_, st)
      k = k + 1
    }
    return d
  }
  if major == 7 {
    if b0 == 244 { return false }
    if b0 == 245 { return true }
    if b0 == 246 { return nil }
    if b0 == 251 {
      let bits_ = bytes_[st["i"]:st["i"]+8]
      st["i"] = st["i"] + 8
      return _bits_to_f64(bits_)
    }
  }
  throw {"type": "LarzValueError", "message": "cbor: unsupported major type " + str(major)}
}

fn _bits_to_f64(bytes_) {
  let sign = bytes_[0] // 128 == 1 ? -1 : 1
  let biased = (bytes_[0] % 128) * 16 + bytes_[1] // 16
  let mantissa = (bytes_[1] % 16)
  let i = 2
  while i < 8 { mantissa = mantissa * 256 + bytes_[i]; i = i + 1 }
  if biased == 0 and mantissa == 0 { return sign * 0.0 }
  let exp = biased - 1023
  let frac = 1 + mantissa / 4503599627370496.0
  let v = frac
  let e = exp
  while e > 0 { v = v * 2; e = e - 1 }
  while e < 0 { v = v / 2; e = e + 1 }
  return sign * v
}

fn decode(bytes_) {
  let st = {"i": 0}
  return _dec(bytes_, st)
}
