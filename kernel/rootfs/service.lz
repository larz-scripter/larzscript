# service - manage LarzOS services (like systemctl).  config persists in /home.
let CONF = "/home/.larzos/services.conf"
let REG = {"web": "/webserver.lz"}          # service name -> program
fn _enabled(name) {
  if not file_exists(CONF) { return false }
  for l in read_file(CONF).split("\n") {
    let p = l.split(" ")
    if len(p) >= 2 and p[0] == name and p[1] == "1" { return true }
  }
  return false
}
fn _set(name, on) {
  let lines = []
  let found = false
  if file_exists(CONF) {
    for l in read_file(CONF).split("\n") {
      if l.strip() == "" { continue }
      let p = l.split(" ")
      if p[0] == name { lines.push(name + " " + (on ? "1" : "0")); found = true }
      else { lines.push(l) }
    }
  }
  if not found { lines.push(name + " " + (on ? "1" : "0")) }
  mkdir("/home/.larzos"); write_file(CONF, join(lines, "\n"))
}
fn run(args) {
  if len(args) == 0 or args[0] == "list" or args[0] == "status" {
    print("services:")
    for name in sorted(keys(REG)) {
      print("  " + name.ljust(10) + (_enabled(name) ? "enabled " : "disabled") + "  -> " + REG[name])
    }
    print("commands: service enable|disable|start <name>")
    return
  }
  let cmd = args[0]
  if cmd == "enable" and len(args) >= 2 { _set(args[1], true); print("enabled " + args[1]) }
  else if cmd == "disable" and len(args) >= 2 { _set(args[1], false); print("disabled " + args[1]) }
  else if cmd == "start" and len(args) >= 2 {
    if not REG.has(args[1]) { print("no such service: " + args[1]); return }
    print("starting service '" + args[1] + "' (Ctrl-A X in QEMU to stop)...")
    import REG[args[1]] as _s          # runs the service (blocks)
  }
  else { print("usage: service [list | enable <n> | disable <n> | start <n>]") }
}
