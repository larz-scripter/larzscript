# fetch - shell command: real HTTP GET over LarzOS's own network stack
# (kernel/net.c, via the `net` package) - the `ping`/`netstat`/`resolve`
# "prove real networking works from the terminal" pattern, for HTTP GET.
#
#   fetch HOST[:PORT] PATH

import "net" as net
import "ip" as ip

fn run(args) {
  if len(args) < 2 { print("usage: fetch HOST[:PORT] PATH"); return }
  if not net.status()["up"] { print("fetch: no network link"); return }
  let hostport = args[0]
  let path = args[1]
  let host = hostport
  let port = 80
  if hostport.contains(":") {
    let parts = hostport.split(":")
    host = parts[0]
    port = int(parts[1])
  }
  let addr = ip.is_valid(host) ? host : net.resolve(host)
  if addr == nil { print("fetch: could not resolve " + host); return }
  let body = net.get(addr, port, path)
  if body == nil { print("fetch: request failed"); return }
  print(body)
}
