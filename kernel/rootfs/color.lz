# color - ANSI terminal colors for Larzscript. Honours NO_COLOR
# (https://no-color.org - any non-empty value disables all color output,
# checked once at import time) automatically. There's no isatty builtin
# in Larzscript (see the `progress`/`tui` packages for the same
# constraint), so true off-TTY auto-detection isn't possible here -
# set_enabled(false) is the manual equivalent for a caller that knows
# its own output isn't a terminal (e.g. writing to a file or a pipe).
# Every function returns plain, uncolored text when disabled, so a
# disabled run is genuinely pipe-safe, not just "still works."
#
#   import "color" as c
#   print(c.green("ok"), c.red("error"), c.bold(c.cyan("title")))
#   c.set_enabled(false)   # e.g. because you know stdout isn't a TTY
#   print(c.green("plain now"))

let _ESC = chr(27)
let _NO_COLOR = env("NO_COLOR", nil)
let _enabled = _NO_COLOR == nil or len(_NO_COLOR) == 0

fn set_enabled(on) { _enabled = on }
fn is_enabled() { return _enabled }

fn _c(code, s) {
  if not _enabled { return s }
  return _ESC + "[" + str(code) + "m" + s + _ESC + "[0m"
}

fn red(s) { return _c(31, s) }
fn green(s) { return _c(32, s) }
fn yellow(s) { return _c(33, s) }
fn blue(s) { return _c(34, s) }
fn magenta(s) { return _c(35, s) }
fn cyan(s) { return _c(36, s) }
fn gray(s) { return _c(90, s) }
fn bold(s) { return _c(1, s) }
fn dim(s) { return _c(2, s) }
fn underline(s) { return _c(4, s) }
fn invert(s) { return _c(7, s) }
