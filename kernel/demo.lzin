wallet a = $20.00
wallet shop
price coffee = $3.50
pay coffee from a to shop
print(f"a={a.balance}  shop={shop.balance}")
print([x*x for x in range(6)])
print("sum 1..10 =", sum(range(1, 11)))
fn fib(n) { if n < 2 { return n } return fib(n-1) + fib(n-2) }
print("fib(15) =", fib(15))
let d = {"name": "larz", "n": 3}
print(d, len(d))
print(1 / 3)
exit(0)
