# larzpkg - the Larzscript package manager, written in Larzscript itself.
#
# Installs packages from the registry (packages/registry.txt) into
# ~/.larzscript/lib, where `import "name"` finds them. A registry entry is
# either a path inside the official larzscript-packages monorepo, or a
# direct git URL to anyone's own repo - own it, version it, run it
# yourself, no monorepo write access needed. See packages/PUBLISHING.md.
#
# `larzscript pkg ...` (built into the interpreter) finds this file at
# ~/.larzscript/larzpkg.lz for you from any directory - the same as
# running `larzscript ~/.larzscript/larzpkg.lz ...` yourself:
#
#   larzscript pkg install <name>
#   larzscript pkg update [name]
#   larzscript pkg list
#   larzscript pkg remove <name>
#   larzscript pkg search <term>
#   larzscript pkg publish <git-url> [as <name>]

let HOME = env("HOME", ".")
let LIB = HOME + "/.larzscript/lib"
let PACKAGES_REPO_URL = "https://github.com/larz-scripter/larzscript-packages"
let PACKAGES_REPO = HOME + "/.larzscript/packages-repo"
let REGISTRY_URL = "https://raw.githubusercontent.com/larz-scripter/larzscript/main/packages/registry.txt"

# Fetch the registry and parse it into a {name: path-in-packages-repo} dict.
fn load_registry() {
  let tmp = "/tmp/larzpkg_registry.txt"
  run("curl -fsSL " + REGISTRY_URL + " -o " + tmp + " 2>/dev/null")
  let reg = {}
  if not file_exists(tmp) {
    print("warning: could not reach the registry (offline?)")
    return reg
  }
  for line in read_file(tmp).split("\n") {
    let t = line.strip()
    if len(t) == 0 or t[0] == "#" { continue }
    let parts = [p for p in t.split(" ") if p != ""]
    if len(parts) >= 2 { reg[parts[0]] = parts[1] }
  }
  return reg
}

# Clone the shared packages repo once, or pull it up to date. A shallow clone
# combined with --ff-only can fail if upstream history is ever rewritten;
# self-heal by re-cloning fresh rather than trying to recover a shallow repo.
fn ensure_packages_repo() {
  run("mkdir -p " + HOME + "/.larzscript")
  if file_exists(PACKAGES_REPO) {
    let rc = run("git -C " + PACKAGES_REPO + " pull --ff-only --quiet 2>/dev/null")
    if rc != 0 {
      print("packages repo out of sync, re-cloning fresh...")
      run("rm -rf " + PACKAGES_REPO)
      run("git clone --depth 1 --quiet " + PACKAGES_REPO_URL + " " + PACKAGES_REPO)
    }
  } else {
    run("git clone --depth 1 --quiet " + PACKAGES_REPO_URL + " " + PACKAGES_REPO)
  }
}

# A registry value is either a path inside the shared packages-repo monorepo
# (today's official packages) or a direct git URL - anyone's own repo, no
# monorepo write access needed. Split an optional @ref (branch/tag, for
# pinning) and #subpath (if main.lz isn't at the repo root) off a URL value.
# https://github.com/alice/lz-coolmath@v1.2.0#sub/dir
#   -> ["https://github.com/alice/lz-coolmath", "v1.2.0", "sub/dir"]
fn parse_pkg_value(value) {
  let v = value
  let subpath = ""
  let hpos = v.find("#")
  if hpos >= 0 { subpath = v[hpos + 1:]; v = v[0:hpos] }
  let ref = ""
  let apos = v.find("@")
  if apos >= 0 { ref = v[apos + 1:]; v = v[0:apos] }
  return [v, ref, subpath]
}

# Copy the resolved package source -> ~/.larzscript/lib/<name>, replacing
# whatever was there. Shared by both install and update - the only
# difference between them is which message makes sense to print first.
fn sync_package(name, value) {
  run("mkdir -p " + LIB)
  let dest = LIB + "/" + name
  run("rm -rf " + dest)
  if value.contains("://") {
    let parsed = parse_pkg_value(value)
    let url = parsed[0]
    let ref = parsed[1]
    let subpath = parsed[2]
    let tmp = "/tmp/larzpkg_ext_" + name
    run("rm -rf " + tmp)
    let clone_cmd = "git clone --depth 1 "
    if ref != "" { clone_cmd = clone_cmd + "--branch " + ref + " " }
    clone_cmd = clone_cmd + url + " " + tmp + " 2>/dev/null"
    if run(clone_cmd) != 0 { run("rm -rf " + tmp); return false }
    let src = subpath != "" ? tmp + "/" + subpath : tmp
    let ok = run("cp -r " + src + " " + dest) == 0
    run("rm -rf " + tmp)
    if ok { run("rm -rf " + dest + "/.git") }
    return ok
  } else {
    ensure_packages_repo()
    return run("cp -r " + PACKAGES_REPO + "/" + value + " " + dest) == 0
  }
}

fn install(name) {
  let reg = load_registry()
  if not reg.has(name) {
    print("package '" + name + "' not found in the registry")
    print("run 'larzpkg search' to see what's available")
    return
  }
  let dest = LIB + "/" + name
  let verb = file_exists(dest) ? "updating" : "installing"
  print(verb + " " + name + " ...")
  if sync_package(name, reg[name]) {
    print(name + " is up to date  ->  " + dest)
    print("use it with:  import \"" + name + "\"")
  } else {
    print("failed to sync " + name + " (is git installed and the source reachable?)")
  }
}

fn update(name) { install(name) }

fn update_all() {
  if not file_exists(LIB) { print("(no packages installed)"); return }
  let names = listdir(LIB)
  if len(names) == 0 { print("(no packages installed)"); return }
  let reg = load_registry()
  for name in sorted(names) {
    if reg.has(name) { install(name) }
    else { print("skipping " + name + " (no longer in the registry)") }
  }
}

fn list_installed() {
  if not file_exists(LIB) {
    print("(no packages installed)")
    return
  }
  let names = listdir(LIB)
  if len(names) == 0 { print("(no packages installed)"); return }
  print("installed packages (" + str(len(names)) + "):")
  for name in sorted(names) { print("  " + name) }
}

fn remove_pkg(name) {
  let dest = LIB + "/" + name
  if file_exists(dest) {
    run("rm -rf " + dest)
    print("removed " + name)
  } else {
    print("not installed: " + name)
  }
}

fn search(term) {
  let reg = load_registry()
  let hits = 0
  for name in sorted(keys(reg)) {
    if term == "" or name.contains(term) {
      print("  " + name)
      hits = hits + 1
    }
  }
  if hits == 0 { print("(no matching packages)") }
}

# A short name from a git URL if the caller didn't give one - strips any
# @ref/#subpath, the trailing ".git", and a "lz-" prefix (the convention the
# original 17 pre-monorepo packages used: lz-mathx -> mathx).
fn derive_name(url) {
  let clean = url
  let hpos = clean.find("#"); if hpos >= 0 { clean = clean[0:hpos] }
  let apos = clean.find("@"); if apos >= 0 { clean = clean[0:apos] }
  let parts = clean.split("/")
  let base = parts[len(parts) - 1]
  if base.ends_with(".git") { base = base[0:len(base) - 4] }
  if base.starts_with("lz-") { base = base[3:] }
  return base
}

# "Publish" in a decentralized registry means "list your own repo," not
# "push code into ours" - so this never writes anywhere. It sanity-checks
# the repo is reachable and shaped like a package, then prints the exact
# line to add and GitHub's own fork+edit+PR URL for registry.txt - no `gh`
# CLI, no auth, no new dependency, matching the project's zero-dep ethos.
fn publish(url, name) {
  if name == "" { name = derive_name(url) }
  print("checking " + url + " ...")
  if run("git ls-remote " + url + " >/dev/null 2>&1") != 0 {
    print("could not reach that repo - check the URL and try again")
    return
  }
  let tmp = "/tmp/larzpkg_publish_check"
  run("rm -rf " + tmp)
  let cloned = run("git clone --depth 1 --quiet " + url + " " + tmp + " 2>/dev/null") == 0
  let has_main = cloned and file_exists(tmp + "/main.lz")
  run("rm -rf " + tmp)
  if not has_main {
    print("warning: no main.lz found at the repo root - if it's in a subdirectory,")
    print("add #subpath to the URL below, e.g. " + url + "#path/to/pkg")
  }
  print("")
  print("add this line to packages/registry.txt:")
  print("")
  print("  " + name + "  " + url)
  print("")
  print("then open a PR (GitHub forks + lets you edit + submit, right in the browser):")
  print("  https://github.com/larz-scripter/larzscript/edit/main/packages/registry.txt")
}

# ---- dispatch ----
fn usage() {
  print("larzpkg - the Larzscript package manager")
  print("usage:")
  print("  larzscript pkg install <name>")
  print("  larzscript pkg update [name]   (all installed packages if name omitted)")
  print("  larzscript pkg remove <name>")
  print("  larzscript pkg list")
  print("  larzscript pkg search [term]")
  print("  larzscript pkg publish <git-url> [as <name>]")
}

if len(args) == 0 {
  usage()
} else {
  let cmd = args[0]
  if cmd == "install" and len(args) >= 2 { install(args[1]) }
  else if cmd == "update" { if len(args) >= 2 { update(args[1]) } else { update_all() } }
  else if cmd == "remove" and len(args) >= 2 { remove_pkg(args[1]) }
  else if cmd == "list" { list_installed() }
  else if cmd == "search" { search(len(args) >= 2 ? args[1] : "") }
  else if cmd == "publish" and len(args) >= 2 {
    let name = (len(args) >= 4 and args[2] == "as") ? args[3] : ""
    publish(args[1], name)
  }
  else { usage() }
}
