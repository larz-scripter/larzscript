fn sq(n) { return n * n }
fn sumto(n) { let t = 0; for i in range(1, n + 1) { t = t + i } return t }
print("sq(9) =", sq(9))
print("sum 1..100 =", sumto(100))
let xs = [10, 20, 30]
let acc = []
for x in xs { push(acc, sq(x)) }
print("squared:", acc, "len:", len(acc), "first:", acc[0])
let msg = "ok" == "ok" ? "yes" : "no"
print("ternary:", msg)
