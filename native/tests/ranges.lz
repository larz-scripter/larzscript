print(range(5), range(2, 8), range(0, 20, 5), range(5, 0, -1))
print(len(range(1000)), len(range(2, 8)), len(range(0, 10, 3)))
print(range(10)[0], range(10)[-1], range(2, 20, 3)[2])
print(4 in range(10), 4 in range(0, 10, 3), -1 in range(10))
print(sum(range(101)), sorted(range(5, 0, -1)))
print([x * 2 for x in range(5)])
print(list(range(4)), reversed(range(4)))
print(type(range(3)), len(range(100000000)))
