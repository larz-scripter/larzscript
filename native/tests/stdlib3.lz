print(all([1, 2, 3]), all([1, 0, 3]), any([0, 0, 1]), any([0, 0]))
print(count([1, 2, 2, 3, 2], 2), count("banana", "a"))
print(unique([1, 2, 2, 3, 1, 3]))
print(hex(255), bin(10), oct(64))
print(gcd(48, 36), factorial(5), sign(-7), clamp(15, 0, 10))
print(list("abc"), list({"x": 1, "y": 2}))
print(dict([["a", 1], ["b", 2]]))
print("hello world".capitalize(), "hello world".title())
print("hi".ljust(5, "."), "hi".rjust(5, "."))
let xs = [1, 2, 3]
xs.extend([4, 5])
print(xs, xs.count(2))
xs.clear()
print(xs, len(xs))
