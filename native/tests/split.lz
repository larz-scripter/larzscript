wallet buyer = $100.00
wallet creator = $0.00
wallet platform = $0.00
wallet tax = $0.00

split $100.00 from buyer {
  creator 70%
  platform 20%
  tax 10%
}
print(buyer.balance, creator.balance, platform.balance, tax.balance)

wallet buyer2 = $10.00
wallet a = $0.00
wallet b = $0.00
wallet c = $0.00

split $10.00 from buyer2 {
  a 33.33%
  b 33.33%
  c 33.34%
}
print(a.balance, b.balance, c.balance)
print(a.balance + b.balance + c.balance)
