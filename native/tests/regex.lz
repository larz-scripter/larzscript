print(regex_match("[0-9]+", "abc123"))
print(regex_match("^[0-9]+$", "abc123"))
print(regex_match("^[0-9]+$", "123"))
print(regex_find("[0-9]+", "abc123def456"))
print(regex_find("[0-9]+", "abc123def456", 6))
print(regex_find("zzz", "abc"))
print(regex_match("colou?r", "color"))
print(regex_match("colou?r", "colour"))
print(regex_match("colou?r", "colouur"))
print(regex_match("a.c", "abc"))
print(regex_match("\\d+", "42"))
print(regex_match("\\w+@\\w+", "foo@bar"))
print(regex_replace("[^a-z0-9]+", "hello, world! 2026", "-"))
print(regex_split("\\s+", "a   b\tc  d"))
print(regex_find("\\[[^\\]]+\\]\\([^)]+\\)", "see [a link](/x/) here"))
print(regex_replace("\\[[^\\]]+\\]\\([^)]+\\)", "see [a link](/x/) here", "LINK"))
print(regex_match("[a-z\\-]+", "he-llo"))
